# Simple square (quad) with texture mapping
# Vertices
v -1.0  1.0 0.0
v -1.0 -1.0 0.0
v  1.0 -1.0 0.0
v  1.0  1.0 0.0

# Texture coordinates (UVs)
vt 0.0 1.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0

# Normals (facing +Z)
vn 0.0 0.0 1.0

# Material
mtllib square.mtl
usemtl SquareMaterial

# Face (two triangles, format: vertex/uv/normal)
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1